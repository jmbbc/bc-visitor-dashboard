rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow reads for core collections used by the dashboard
    match /units/{unitId} {
      allow get, list: if true;

      // Allow admins (custom claim `admin`) to create/update/delete units
      allow create, update, delete: if request.auth != null
        && request.auth.token.admin == true
        && isValidUnit(request.resource.data);
    }

    // Metadata about unit imports (e.g., last CSV upload time)
    match /unitMeta/{docId} {
      // Allow public reads so visitor form can show last update time
      allow read: if true;
      // Writes restricted to admins
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Parking data: require authenticated reads; restrict writes to admins
    match /parkingSlots/{slotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /parkingMeta/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Water readings: allow authenticated reads; restrict writes to admins only
    match /waterReadings/{docId} {
      // only signed-in users can view the daily readings
      allow read: if request.auth != null;
      // only admin users (custom claim `admin`) may create/update/delete readings
      allow create, update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // Daily outstanding snapshots used for monthly arrears chart
    match /outstandingSnapshots/{snapshotId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && isValidOutstandingSnapshot(request.resource.data, snapshotId);
      allow delete: if isAdmin();
    }

    // Visitor form responses: allow public create with strict validation
    match /responses/{respId} {
      allow create: if isValidResponse(request.resource.data);
      allow update: if (isAdmin() && isValidResponse(request.resource.data))
        || canAmendResponse(resource.data, request.resource.data, respId);
      allow read, delete: if request.auth != null;
    }

    // Dedupe keys for transaction-based duplicate prevention (public create/update only with linked response in same request)
    match /dedupeKeys/{keyId} {
      allow get: if true;
      allow create, update: if isValidDedupeKey(request.resource.data)
        && existsAfter(/databases/$(database)/documents/responses/$(request.resource.data.responseId));
      allow delete, list: if false;
    }

    // Overnight lock to force Pelawat Bermalam vehicle combination in one submission
    match /overnightLocks/{lockId} {
      allow get: if true;
      allow create: if isValidOvernightLock(request.resource.data, lockId)
        && existsAfter(/databases/$(database)/documents/responses/$(request.resource.data.responseId));
      allow update: if (isValidOvernightLock(request.resource.data, lockId)
        && existsAfter(/databases/$(database)/documents/responses/$(request.resource.data.responseId)))
        || (isAdmin() && isValidOvernightLock(request.resource.data, lockId)
          && isAdminParkingReviewUpdate(resource.data, request.resource.data));
      allow delete, list: if false;
    }

    match /parkingReviewQueue/{unitId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidParkingReview(request.resource.data, unitId);
      allow update: if isAdmin() && resource.data.status == 'pending'
        && request.resource.data.status == 'resolved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','finalCategory','finalMainUsageDays','finalCycleStart','finalLastMainEnd','finalLastAnyEnd','resolutionReason','resolvedBy','resolvedByEmail','resolvedAt'])
        && isValidParkingReview(request.resource.data, unitId);
      allow delete: if false;
    }

    // Audit logs: authenticated users may write and read; deletes disabled
    match /audit/{docId} {
      allow create, read: if request.auth != null;
      allow delete: if false;
      allow update: if false;
    }

    // Payment storage: separate from visitor submission and existing collections.
    // No anonymous provider, even if its token unexpectedly carries a staff claim.
    function paymentAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.auth.token.admin == true;
    }
    function paymentStaff() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && (request.auth.token.get('admin', false) == true
          || request.auth.token.get('guard', false) == true);
    }
    function validPaymentAllocation(item) {
      return item.keys().hasOnly(['chargeId','amountSen'])
        && item.chargeId is string && item.amountSen is int && item.amountSen > 0
        && exists(/databases/$(database)/documents/parkingCharges/$(item.chargeId));
    }
    function validPaymentAllocations(items, ids, amount) {
      return items is list && ids is list && items.size() > 0 && items.size() <= 8
        && ids.size() == items.size() && ids.toSet().size() == ids.size()
        && (items.size() <= 0 || validPaymentAllocation(items[0]))
        && (items.size() <= 1 || validPaymentAllocation(items[1]))
        && (items.size() <= 2 || validPaymentAllocation(items[2]))
        && (items.size() <= 3 || validPaymentAllocation(items[3]))
        && (items.size() <= 4 || validPaymentAllocation(items[4]))
        && (items.size() <= 5 || validPaymentAllocation(items[5]))
        && (items.size() <= 6 || validPaymentAllocation(items[6]))
        && (items.size() <= 7 || validPaymentAllocation(items[7]))
        && (ids.size() <= 0 || ids[0] == items[0].chargeId)
        && (ids.size() <= 1 || ids[1] == items[1].chargeId)
        && (ids.size() <= 2 || ids[2] == items[2].chargeId)
        && (ids.size() <= 3 || ids[3] == items[3].chargeId)
        && (ids.size() <= 4 || ids[4] == items[4].chargeId)
        && (ids.size() <= 5 || ids[5] == items[5].chargeId)
        && (ids.size() <= 6 || ids[6] == items[6].chargeId)
        && (ids.size() <= 7 || ids[7] == items[7].chargeId)
        && ((items.size() > 0 ? items[0].amountSen : 0) + (items.size() > 1 ? items[1].amountSen : 0) + (items.size() > 2 ? items[2].amountSen : 0) + (items.size() > 3 ? items[3].amountSen : 0) + (items.size() > 4 ? items[4].amountSen : 0) + (items.size() > 5 ? items[5].amountSen : 0) + (items.size() > 6 ? items[6].amountSen : 0) + (items.size() > 7 ? items[7].amountSen : 0)) <= amount;
    }
    match /parkingCharges/{id} {
      allow read: if paymentStaff();
      allow create: if paymentAdmin()
        && request.resource.data.keys().hasOnly(['registrationId','amountSen','createdBy','createdAt'])
        && request.resource.data.registrationId == id
        && exists(/databases/$(database)/documents/responses/$(id))
        && request.resource.data.amountSen is int
        && request.resource.data.amountSen >= 0 && request.resource.data.amountSen <= 100000000
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if paymentAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amountSen','lastChangeId'])
        && request.resource.data.amountSen is int
        && request.resource.data.amountSen >= 0 && request.resource.data.amountSen <= 100000000
        && !exists(/databases/$(database)/documents/parkingCharges/$(id)/changes/$(request.resource.data.lastChangeId))
        && getAfter(/databases/$(database)/documents/parkingCharges/$(id)/changes/$(request.resource.data.lastChangeId)).data.afterSen == request.resource.data.amountSen;
      allow delete: if false;
      match /changes/{eventId} {
        allow read: if paymentStaff();
        allow create: if paymentAdmin()
          && request.resource.data.keys().hasOnly(['beforeSen','afterSen','reason','by','at'])
          && request.resource.data.beforeSen == get(/databases/$(database)/documents/parkingCharges/$(id)).data.amountSen
          && request.resource.data.afterSen == getAfter(/databases/$(database)/documents/parkingCharges/$(id)).data.amountSen
          && getAfter(/databases/$(database)/documents/parkingCharges/$(id)).data.lastChangeId == eventId
          && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }
    match /parkingReceipts/{id} {
      allow read: if paymentStaff();
      allow create: if paymentStaff()
        && id.matches('^[A-Z0-9_-]{4,80}$')
        && request.resource.data.keys().hasOnly(['chargeId','reference','amountSen','state','createdBy','createdAt'])
        && request.resource.data.chargeId is string
        && exists(/databases/$(database)/documents/parkingCharges/$(request.resource.data.chargeId))
        && request.resource.data.reference == id
        && request.resource.data.amountSen is int
        && request.resource.data.amountSen > 0 && request.resource.data.amountSen <= 100000000
        && request.resource.data.state == 'active'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if paymentAdmin()
        && resource.data.state == 'active'
        && request.resource.data.state == 'voided'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state','voidReason','voidBy','voidAt'])
        && request.resource.data.voidReason is string
        && request.resource.data.voidReason.size() > 0 && request.resource.data.voidReason.size() <= 500
        && request.resource.data.voidBy == request.auth.uid
        && request.resource.data.voidAt == request.time;
      allow update: if paymentAdmin() && resource.data.state == 'active'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['allocations','relatedChargeIds','lastChangeId'])
        && validPaymentAllocations(request.resource.data.allocations, request.resource.data.relatedChargeIds, resource.data.amountSen)
        && !exists(/databases/$(database)/documents/parkingReceipts/$(id)/changes/$(request.resource.data.lastChangeId))
        && getAfter(/databases/$(database)/documents/parkingReceipts/$(id)/changes/$(request.resource.data.lastChangeId)).data.after == request.resource.data.allocations;
      allow delete: if false;
      match /changes/{eventId} {
        allow read: if paymentStaff();
        allow create: if paymentAdmin()
          && request.resource.data.keys().hasOnly(['before','after','reason','by','at'])
          && request.resource.data.before == get(/databases/$(database)/documents/parkingReceipts/$(id)).data.get('allocations', [{'chargeId':get(/databases/$(database)/documents/parkingReceipts/$(id)).data.chargeId, 'amountSen':get(/databases/$(database)/documents/parkingReceipts/$(id)).data.amountSen}])
          && request.resource.data.after == getAfter(/databases/$(database)/documents/parkingReceipts/$(id)).data.allocations
          && getAfter(/databases/$(database)/documents/parkingReceipts/$(id)).data.lastChangeId == eventId
          && request.resource.data.reason is string && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 500
          && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time;
        allow update, delete: if false;
      }
    }

    // Deny everything else by default (explicit)
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // Validation helper for a unit doc
    function isValidUnit(data) {
      return data is map
        && (data.keys().hasAll(['arrears', 'arrearsAmount', 'category', 'lastUpdatedAt', 'lastUpdatedBy'])
            || data.keys().hasAny(['arrears','arrearsAmount','category','originalUnit']))
        && (data.arrears is bool)
        && (data.arrearsAmount is number || data.arrearsAmount == null)
        && (data.category is string || !('category' in data))
        && (data.lastUpdatedAt is timestamp || !('lastUpdatedAt' in data))
        && (data.lastUpdatedBy is string || !('lastUpdatedBy' in data));
    }

    // Validation helper for a visitor response doc
    function isValidResponse(data) {
      return data is map
        // required keys
        && data.keys().hasAll(['hostUnit','hostName','category','visitorName','eta','createdAt','updatedAt','status'])
        // allowed optional keys
        && data.keys().hasOnly([
          'hostUnit','hostUnitFound','hostName','hostPhone','category','subCategory','entryDetails','companyName',
          'visitorName','visitorPhone','stayOver','eta','etd','vehicleNo','vehicleNumbers','vehicleType',
          'vehicleRowsDetailed',
          'subCategoryHelp','status','createdAt','updatedAt',
          'amendToken',
          'parkingQuote','parkingReviewRequired','parkingReviewReason',
          // unit snapshot fields
          'unitCategory','unitArrears','unitArrearsAmount','unitLastUpdatedAt'
        ])
        // type checks
        && (data.hostUnit is string)
        && (data.hostUnitFound is bool || !('hostUnitFound' in data))
        && (data.hostName is string)
        && (data.hostPhone is string || !('hostPhone' in data))
        && (data.category is string)
        && (data.subCategory is string || !('subCategory' in data))
        && (data.entryDetails is string || !('entryDetails' in data))
        && (data.companyName is string || !('companyName' in data))
        && (data.visitorName is string)
        && (data.visitorPhone is string || !('visitorPhone' in data))
        && (data.stayOver is string || !('stayOver' in data))
        && (data.eta is timestamp)
        && (data.etd is timestamp || data.etd == null || !('etd' in data))
        && (data.vehicleNo is string || !('vehicleNo' in data))
        && (data.vehicleNumbers is list || !('vehicleNumbers' in data))
        && (data.vehicleRowsDetailed is list || !('vehicleRowsDetailed' in data))
        && (data.vehicleType is string || !('vehicleType' in data))
        && (data.subCategoryHelp is string || !('subCategoryHelp' in data))
        && (data.status is string)
        && (data.createdAt is timestamp)
        && (data.updatedAt is timestamp)
        && (data.amendToken is string || !('amendToken' in data))
        && (data.parkingQuote is map || !('parkingQuote' in data))
        && (!('parkingQuote' in data) || isValidParkingQuote(data.parkingQuote))
        && (data.parkingReviewRequired is bool || !('parkingReviewRequired' in data))
        && (data.parkingReviewReason is string || !('parkingReviewReason' in data))
        // unit snapshot optional types
        && (data.unitCategory is string || !('unitCategory' in data))
        && (data.unitArrears is bool || !('unitArrears' in data))
        && (data.unitArrearsAmount is number || !('unitArrearsAmount' in data))
        && (data.unitLastUpdatedAt is timestamp || !('unitLastUpdatedAt' in data));
    }

    function isValidDedupeKey(data) {
      return data is map
        && data.keys().hasOnly(['responseId','hostUnit','visitorPhone','visitorName','etaDate','createdAt','amendToken'])
        && (data.responseId is string)
        && (data.hostUnit is string)
        && (data.visitorPhone is string)
        && (data.visitorName is string)
        && (data.etaDate is string)
        && (data.createdAt is timestamp)
        && (data.amendToken is string || !('amendToken' in data));
    }

    function isValidParkingQuote(data) {
      return data.keys().hasOnly(['policyVersion','mainTotalSen','mainStartDay','mainEndDay','calculatedAt'])
        && data.policyVersion is string
        && data.mainTotalSen is int && data.mainTotalSen >= 0
        && data.mainStartDay is int && data.mainStartDay >= 1
        && data.mainEndDay is int && data.mainEndDay >= data.mainStartDay
        && data.calculatedAt is timestamp;
    }

    function isValidOutstandingSnapshot(data, snapshotId) {
      return data is map
        && data.keys().hasOnly(['dateKey','monthKey','day','totalOutstanding','unitsWithArrears','totalUnits','source','capturedBy','capturedAt','updatedAt'])
        && (data.dateKey is string)
        && (snapshotId == data.dateKey)
        && (data.monthKey is string)
        && (data.day is int)
        && (data.day >= 1 && data.day <= 31)
        && (data.totalOutstanding is number)
        && (data.totalOutstanding >= 0)
        && (data.unitsWithArrears is int)
        && (data.unitsWithArrears >= 0)
        && (data.totalUnits is int)
        && (data.totalUnits >= 0)
        && (data.source is string)
        && (data.capturedBy is string)
        && (data.capturedAt is timestamp || !('capturedAt' in data))
        && (data.updatedAt is timestamp || !('updatedAt' in data));
    }

    function isValidOvernightLock(data, lockId) {
      return data is map
        && data.keys().hasOnly(['unit','startDate','endDate','category','stayOver','responseId','updatedAt','amendToken','parkingCategory','cycleStart','mainUsageDays','lastMainEnd','lastAnyEnd','parkingPolicyVersion','parkingReviewRequired','parkingStateMigratedAt','parkingReviewedAt','parkingReviewedBy'])
        && (data.unit is string)
        && (data.startDate is timestamp)
        && (data.endDate is timestamp)
        && (data.category is string)
        && (data.stayOver is string)
        && (data.responseId is string)
        && (data.updatedAt is timestamp)
        && (data.amendToken is string || !('amendToken' in data))
        && (data.parkingCategory is int || !('parkingCategory' in data))
        && (data.cycleStart is timestamp || !('cycleStart' in data))
        && (data.mainUsageDays is int || !('mainUsageDays' in data))
        && (data.lastMainEnd is timestamp || !('lastMainEnd' in data))
        && (data.lastAnyEnd is timestamp || !('lastAnyEnd' in data))
        && (data.parkingPolicyVersion is string || !('parkingPolicyVersion' in data))
        && (data.parkingReviewRequired is bool || !('parkingReviewRequired' in data))
        && (data.parkingStateMigratedAt is timestamp || !('parkingStateMigratedAt' in data))
        && (data.parkingReviewedAt is timestamp || !('parkingReviewedAt' in data))
        && (data.parkingReviewedBy is string || !('parkingReviewedBy' in data))
        && (!('mainUsageDays' in data) || data.mainUsageDays >= 0)
        && (!('parkingCategory' in data) || data.parkingCategory in [1,2,3])
        // A newer non-overnight Pelawat lock must not invalidate an older
        // overnight cooldown state confirmed by an admin.
        && (!('lastAnyEnd' in data) || data.stayOver != 'Yes' || data.lastAnyEnd >= data.endDate)
        && (isAdmin() || !('mainUsageDays' in data) || !exists(/databases/$(database)/documents/overnightLocks/$(lockId))
          || !('mainUsageDays' in resource.data)
          || data.mainUsageDays >= resource.data.mainUsageDays
          || (('lastAnyEnd' in resource.data) && data.startDate >= resource.data.lastAnyEnd + duration.value(4, 'd')))
        && (data.category == 'Pelawat')
        && (data.stayOver in ['Yes', 'No'])
        && (lockId == ('unit-' + data.unit))
        && (data.startDate <= data.endDate);
    }

    function isValidParkingReview(data, unitId) {
      return data is map
        && data.keys().hasOnly(['unitId','status','reasons','suggestedCategory','suggestedMainUsageDays','suggestedCycleStart','suggestedLastMainEnd','suggestedLastAnyEnd','sourceResponseCount','generatedAt','finalCategory','finalMainUsageDays','finalCycleStart','finalLastMainEnd','finalLastAnyEnd','resolutionReason','resolvedBy','resolvedByEmail','resolvedAt'])
        && data.unitId == unitId && data.status in ['pending','resolved']
        && data.reasons is list && data.reasons.size() > 0
        && data.sourceResponseCount is int && data.sourceResponseCount > 0
        && data.generatedAt is timestamp
        && (data.suggestedCategory is int || !('suggestedCategory' in data))
        && (data.suggestedMainUsageDays is int || !('suggestedMainUsageDays' in data))
        && (data.suggestedCycleStart is timestamp || !('suggestedCycleStart' in data))
        && (data.suggestedLastMainEnd is timestamp || !('suggestedLastMainEnd' in data))
        && (data.suggestedLastAnyEnd is timestamp || !('suggestedLastAnyEnd' in data))
        && (data.status == 'pending' || (data.finalCategory in [1,2,3]
          && data.finalMainUsageDays is int && data.finalMainUsageDays >= 0
          && data.finalCycleStart is timestamp && data.finalLastMainEnd is timestamp && data.finalLastAnyEnd is timestamp
          && data.resolutionReason is string && data.resolutionReason.size() > 2 && data.resolutionReason.size() <= 500
          && data.resolvedBy == request.auth.uid && data.resolvedByEmail is string && data.resolvedAt == request.time));
    }

    function isAdminParkingReviewUpdate(oldData, newData) {
      return newData.diff(oldData).affectedKeys().hasOnly(['parkingCategory','cycleStart','mainUsageDays','lastMainEnd','lastAnyEnd','parkingPolicyVersion','parkingReviewRequired','parkingReviewedAt','parkingReviewedBy'])
        && newData.parkingReviewRequired == false
        && newData.parkingReviewedAt == request.time
        && newData.parkingReviewedBy == request.auth.uid;
    }

    function canAmendResponse(oldData, newData, respId) {
      let lockId = 'unit-' + oldData.hostUnit;
      let lockMatches = oldData.category != 'Pelawat'
        || (
          exists(/databases/$(database)/documents/overnightLocks/$(lockId))
          && get(/databases/$(database)/documents/overnightLocks/$(lockId)).data.responseId == respId
          && get(/databases/$(database)/documents/overnightLocks/$(lockId)).data.amendToken == oldData.amendToken
        );
      return isValidResponse(newData)
        && oldData.status == 'Pending'
        && newData.status == oldData.status
        && oldData.hostUnit == newData.hostUnit
        && oldData.category == newData.category
        && oldData.eta == newData.eta
        && oldData.createdAt == newData.createdAt
        && oldData.amendToken is string
        && newData.amendToken == oldData.amendToken
        && request.time < oldData.createdAt + duration.value(24, 'h')
        && lockMatches;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
  }
}
